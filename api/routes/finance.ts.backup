import { Router, Response } from 'express';
import { getDb } from '../db/database';
import { AuthRequest } from '../middleware/auth';
import { FinanceReport } from '../../shared/types';
import { generateId } from '../utils/helpers';
import { v4 as uuidv4 } from 'uuid';

const router = Router();

router.get('/reports', async (req: AuthRequest, res: Response) => {
  try {
    const { month, reportMonth, zoneId } = req.query;
    const targetMonth = month || reportMonth;
    const db = await getDb();
    
    let query = 'SELECT * FROM finance_reports';
    const params: any[] = [];
    const conditions: string[] = [];

    if (targetMonth) {
      conditions.push('report_month = ?');
      params.push(targetMonth);
    }
    if (zoneId) {
      conditions.push('zone_id = ?');
      params.push(zoneId);
    }

    if (conditions.length > 0) {
      query += ' WHERE ' + conditions.join(' AND ');
    }
    query += ' ORDER BY report_month DESC, zone_name';

    const result = db.exec(query, params);
    
    const reports: FinanceReport[] = [];
    if (result.length > 0) {
      result[0].values.forEach(row => {
        reports.push({
          id: row[0] as string,
          reportMonth: row[1] as string,
          zoneId: row[2] as string,
          zoneName: row[3] as string,
          output: row[4] as number,
          cost: {
            fry: row[5] as number,
            feed: row[6] as number,
            labor: row[7] as number,
            other: row[8] as number
          },
          income: row[9] as number,
          diseaseLossRate: row[10] as number,
          profit: row[11] as number,
          comparedLastMonth: {
            output: row[12] as number || 0,
            cost: row[13] as number || 0,
            income: row[14] as number || 0,
            profit: row[15] as number || 0
          },
          createdAt: row[16] as string,
          pushed: row[17] as number === 1
        });
      });
    }

    res.json({ success: true, data: reports });
  } catch (err) {
    console.error('Get finance reports error:', err);
    res.status(500).json({ error: '获取财务报表失败' });
  }
});

router.get('/reports/:id', async (req: AuthRequest, res: Response) => {
  try {
    const { id } = req.params;
    const db = await getDb();

    const result = db.exec('SELECT * FROM finance_reports WHERE id = ?', [id]);
    if (result.length === 0 || result[0].values.length === 0) {
      return res.status(404).json({ error: '报表不存在' });
    }

    const row = result[0].values[0];
    const report: FinanceReport = {
      id: row[0] as string,
      reportMonth: row[1] as string,
      zoneId: row[2] as string,
      zoneName: row[3] as string,
      output: row[4] as number,
      cost: {
        fry: row[5] as number,
        feed: row[6] as number,
        labor: row[7] as number,
        other: row[8] as number
      },
      income: row[9] as number,
      diseaseLossRate: row[10] as number,
      profit: row[11] as number,
      comparedLastMonth: {
        output: row[12] as number || 0,
        cost: row[13] as number || 0,
        income: row[14] as number || 0,
        profit: row[15] as number || 0
      },
      createdAt: row[16] as string,
      pushed: row[17] as number === 1
    };

    res.json({ success: true, data: report });
  } catch (err) {
    console.error('Get finance report error:', err);
    res.status(500).json({ error: '获取财务报表失败' });
  }
});

router.post('/reports/generate', async (req: AuthRequest, res: Response) => {
  try {
    const { reportMonth } = req.body;
    const db = await getDb();

    const zonesResult = db.exec('SELECT * FROM zones');
    if (zonesResult.length === 0 || zonesResult[0].values.length === 0) {
      return res.status(400).json({ error: '没有养殖区数据' });
    }

    const month = reportMonth || new Date().toISOString().slice(0, 7);
    const prevMonth = new Date(month + '-01');
    prevMonth.setMonth(prevMonth.getMonth() - 1);
    const prevMonthStr = prevMonth.toISOString().slice(0, 7);

    const generatedReports: FinanceReport[] = [];
    const now = new Date().toISOString();

    for (const zoneRow of zonesResult[0].values) {
      const zoneId = zoneRow[0] as string;
      const zoneName = zoneRow[1] as string;
      
      const output = 25000 + Math.random() * 50000;
      const fryCost = output * 8;
      const feedCost = output * 12;
      const laborCost = output * 6;
      const otherCost = output * 3;
      const income = output * (35 + Math.random() * 15);
      const totalCost = fryCost + feedCost + laborCost + otherCost;
      const profit = income - totalCost;
      const diseaseLossRate = 0.02 + Math.random() * 0.04;

      const prevResult = db.exec(
        'SELECT output, fry_cost + feed_cost + labor_cost + other_cost as total_cost, income, profit FROM finance_reports WHERE report_month = ? AND zone_id = ?',
        [prevMonthStr, zoneId]
      );

      let outputChange = 0, costChange = 0, incomeChange = 0, profitChange = 0;
      if (prevResult.length > 0 && prevResult[0].values.length > 0) {
        const prevRow = prevResult[0].values[0];
        const prevOutput = prevRow[0] as number;
        const prevCost = prevRow[1] as number;
        const prevIncome = prevRow[2] as number;
        const prevProfit = prevRow[3] as number;
        
        outputChange = ((output - prevOutput) / prevOutput) * 100;
        costChange = ((totalCost - prevCost) / prevCost) * 100;
        incomeChange = ((income - prevIncome) / prevIncome) * 100;
        profitChange = ((profit - prevProfit) / prevProfit) * 100;
      }

      const existingResult = db.exec(
        'SELECT id FROM finance_reports WHERE report_month = ? AND zone_id = ?',
        [month, zoneId]
      );

      let reportId: string;
      if (existingResult.length > 0 && existingResult[0].values.length > 0) {
        reportId = existingResult[0].values[0][0] as string;
        db.run(
          `UPDATE finance_reports 
           SET output = ?, fry_cost = ?, feed_cost = ?, labor_cost = ?, other_cost = ?,
               income = ?, disease_loss_rate = ?, profit = ?, output_change = ?, cost_change = ?,
               income_change = ?, profit_change = ?, pushed = 1
           WHERE id = ?`,
          [output, fryCost, feedCost, laborCost, otherCost, income, diseaseLossRate,
           profit, outputChange, costChange, incomeChange, profitChange, reportId]
        );
      } else {
        reportId = generateId();
        db.run(
          `INSERT INTO finance_reports 
           (id, report_month, zone_id, zone_name, output, fry_cost, feed_cost, labor_cost,
            other_cost, income, disease_loss_rate, profit, output_change, cost_change,
            income_change, profit_change, created_at, pushed)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
          [reportId, month, zoneId, zoneName, output, fryCost, feedCost, laborCost,
           otherCost, income, diseaseLossRate, profit, outputChange, costChange,
           incomeChange, profitChange, now, 1]
        );
      }

      generatedReports.push({
        id: reportId,
        reportMonth: month,
        zoneId,
        zoneName,
        output,
        cost: { fry: fryCost, feed: feedCost, labor: laborCost, other: otherCost },
        income,
        diseaseLossRate,
        profit,
        comparedLastMonth: {
          output: outputChange,
          cost: costChange,
          income: incomeChange,
          profit: profitChange
        },
        createdAt: now,
        pushed: true
      });

      // 获取所有admin和finance用户
      const users = db.exec("SELECT id FROM users WHERE role IN ('admin', 'finance')")[0]?.values?.map(r => r[0] as string) || [];
      
      // 为每个用户插入消息
      users.forEach(userId => {
        const msgId = uuidv4();
        db.run(`INSERT INTO messages (id, user_id, type, title, content, related_id, related_type, has_voucher, is_read, created_at) 
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`, [
          msgId, userId, 'system', 
          `月度报表已推送`, 
          `${month}月${zoneName}财务报表已生成，产量${output.toFixed(0)}kg，利润${profit.toFixed(2)}元。`,
          reportId, 'finance', 1, 0, now
        ]);
      });
    }

    res.json({ success: true, data: { message: '报表生成成功', reports: generatedReports } });
  } catch (err) {
    console.error('Generate finance reports error:', err);
    res.status(500).json({ error: '生成财务报表失败' });
  }
});

export default router;
