import initSqlJs, { Database } from 'sql.js';
import { v4 as uuidv4 } from 'uuid';

let db: Database | null = null;

const initDatabase = async (): Promise<Database> => {
  if (db) return db;

  const SQL = await initSqlJs({
    locateFile: (file: string) => `https://sql.js.org/dist/${file}`
  });

  db = new SQL.Database();

    SQL = await initSqlJs({
      wasmBinary: wasmBuffer,
    });
      password_hash TEXT NOT NULL,
      name TEXT NOT NULL,
      role TEXT NOT NULL CHECK(role IN ('farmer', 'technician', 'admin', 'finance')),
      phone TEXT,
      email TEXT,
      status TEXT NOT NULL DEFAULT 'active',
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      last_login DATETIME
    )
  `);

  db.run(`
    CREATE TABLE zones (
      id TEXT PRIMARY KEY,
      name TEXT NOT NULL,
      area REAL NOT NULL,
      target_output REAL NOT NULL,
      status TEXT NOT NULL DEFAULT 'normal' CHECK(status IN ('normal', 'warning', 'locked')),
      current_stock REAL DEFAULT 0,
      growth_rate REAL DEFAULT 0,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )
  `);

  db.run(`
    CREATE TABLE disease_rules (
      id TEXT PRIMARY KEY,
      zone_id TEXT NOT NULL,
      indicator TEXT NOT NULL,
      threshold REAL NOT NULL,
      action TEXT NOT NULL CHECK(action IN ('notify', 'lock')),
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (zone_id) REFERENCES zones(id)
    )
  `);

  db.run(`
    CREATE TABLE fry_releases (
      id TEXT PRIMARY KEY,
      zone_id TEXT NOT NULL,
      zone_name TEXT NOT NULL,
      species TEXT NOT NULL,
      quantity INTEGER NOT NULL,
      recommended_density REAL NOT NULL,
      feed_formula TEXT NOT NULL,
      water_temp REAL NOT NULL,
      salinity REAL NOT NULL,
      dissolved_oxygen REAL NOT NULL,
      historical_mortality REAL NOT NULL,
      archive_id TEXT,
      operator TEXT NOT NULL,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (zone_id) REFERENCES zones(id)
    )
  `);

  db.run(`
    CREATE TABLE breeding_archives (
      id TEXT PRIMARY KEY,
      fry_release_id TEXT NOT NULL,
      content TEXT NOT NULL,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (fry_release_id) REFERENCES fry_releases(id)
    )
  `);

  db.run(`
    CREATE TABLE water_quality (
      id TEXT PRIMARY KEY,
      zone_id TEXT NOT NULL,
      zone_name TEXT NOT NULL,
      temperature REAL NOT NULL,
      salinity REAL NOT NULL,
      dissolved_oxygen REAL NOT NULL,
      ph REAL NOT NULL,
      ammonia_nitrogen REAL NOT NULL,
      nitrite REAL NOT NULL,
      recorded_by TEXT NOT NULL,
      recorded_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      is_normal BOOLEAN DEFAULT 1,
      abnormal_items TEXT,
      FOREIGN KEY (zone_id) REFERENCES zones(id)
    )
  `);

  db.run(`
    CREATE TABLE warnings (
      id TEXT PRIMARY KEY,
      zone_id TEXT NOT NULL,
      zone_name TEXT NOT NULL,
      type TEXT NOT NULL CHECK(type IN ('water_quality', 'growth', 'disease')),
      level TEXT NOT NULL CHECK(level IN ('low', 'medium', 'high')),
      indicator TEXT NOT NULL,
      current_value REAL NOT NULL,
      threshold REAL NOT NULL,
      consecutive_days INTEGER NOT NULL DEFAULT 1,
      suggestions TEXT NOT NULL,
      status TEXT NOT NULL DEFAULT 'pending' CHECK(status IN ('pending', 'processing', 'resolved')),
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      handled_at DATETIME,
      handled_by TEXT,
      handle_note TEXT,
      FOREIGN KEY (zone_id) REFERENCES zones(id)
    )
  `);

  db.run(`
    CREATE TABLE feeding_plans (
      id TEXT PRIMARY KEY,
      zone_id TEXT NOT NULL,
      zone_name TEXT NOT NULL,
      species TEXT NOT NULL,
      growth_stage TEXT NOT NULL,
      daily_amount REAL NOT NULL,
      frequency INTEGER NOT NULL,
      auto_adjust BOOLEAN DEFAULT 1,
      weather_adjust BOOLEAN DEFAULT 1,
      is_active BOOLEAN DEFAULT 1,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (zone_id) REFERENCES zones(id)
    )
  `);

  db.run(`
    CREATE TABLE feeding_logs (
      id TEXT PRIMARY KEY,
      plan_id TEXT NOT NULL,
      zone_id TEXT NOT NULL,
      zone_name TEXT NOT NULL,
      scheduled_amount REAL NOT NULL,
      actual_amount REAL NOT NULL,
      adjusted_reason TEXT,
      weather TEXT NOT NULL,
      growth_days INTEGER NOT NULL,
      fed_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (plan_id) REFERENCES feeding_plans(id),
      FOREIGN KEY (zone_id) REFERENCES zones(id)
    )
  `);

  db.run(`
    CREATE TABLE sample_tests (
      id TEXT PRIMARY KEY,
      zone_id TEXT NOT NULL,
      zone_name TEXT NOT NULL,
      average_weight REAL NOT NULL,
      survival_rate REAL NOT NULL,
      sample_count INTEGER NOT NULL,
      tested_by TEXT NOT NULL,
      tested_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (zone_id) REFERENCES zones(id)
    )
  `);

  db.run(`
    CREATE TABLE harvest_tasks (
      id TEXT PRIMARY KEY,
      zone_id TEXT NOT NULL,
      zone_name TEXT NOT NULL,
      predicted_output REAL NOT NULL,
      harvest_date DATE NOT NULL,
      status TEXT NOT NULL DEFAULT 'pending' CHECK(status IN ('pending', 'in_progress', 'completed')),
      task_order_no TEXT NOT NULL,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (zone_id) REFERENCES zones(id)
    )
  `);

  db.run(`
    CREATE TABLE orders (
      id TEXT PRIMARY KEY,
      order_no TEXT NOT NULL,
      zone_id TEXT NOT NULL,
      zone_name TEXT NOT NULL,
      species TEXT NOT NULL,
      quantity REAL NOT NULL,
      unit_price REAL NOT NULL,
      total_amount REAL NOT NULL,
      customer_name TEXT NOT NULL,
      trace_code TEXT,
      status TEXT NOT NULL DEFAULT 'pending' CHECK(status IN ('pending', 'shipped', 'completed')),
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (zone_id) REFERENCES zones(id)
    )
  `);

  db.run(`
    CREATE TABLE trace_codes (
      code TEXT PRIMARY KEY,
      order_id TEXT NOT NULL,
      archive_id TEXT NOT NULL,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (order_id) REFERENCES orders(id)
    )
  `);

  db.run(`
    CREATE TABLE finance_reports (
      id TEXT PRIMARY KEY,
      report_month TEXT NOT NULL,
      zone_id TEXT NOT NULL,
      zone_name TEXT NOT NULL,
      output REAL NOT NULL,
      fry_cost REAL NOT NULL DEFAULT 0,
      feed_cost REAL NOT NULL DEFAULT 0,
      labor_cost REAL NOT NULL DEFAULT 0,
      other_cost REAL NOT NULL DEFAULT 0,
      income REAL NOT NULL,
      disease_loss_rate REAL NOT NULL,
      profit REAL NOT NULL,
      output_change REAL,
      cost_change REAL,
      income_change REAL,
      profit_change REAL,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      pushed BOOLEAN DEFAULT 0,
      FOREIGN KEY (zone_id) REFERENCES zones(id)
    )
  `);

  db.run(`
    CREATE TABLE messages (
      id TEXT PRIMARY KEY,
      user_id TEXT NOT NULL,
      type TEXT NOT NULL CHECK(type IN ('fry_release', 'warning', 'harvest', 'sale', 'system')),
      title TEXT NOT NULL,
      content TEXT NOT NULL,
      related_id TEXT,
      related_type TEXT,
      has_voucher BOOLEAN DEFAULT 0,
      voucher_url TEXT,
      is_read BOOLEAN DEFAULT 0,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (user_id) REFERENCES users(id)
    )
  `);

  db.run(`
    CREATE TABLE threshold_configs (
      id TEXT PRIMARY KEY,
      indicator TEXT UNIQUE NOT NULL,
      min REAL NOT NULL,
      max REAL NOT NULL,
      unit TEXT NOT NULL
    )
  `);

  seedData(db);

  return db;
};

const seedData = (db: Database) => {
  const now = new Date();
  const dateStr = now.toISOString().split('T')[0];

  db.run(`
    INSERT INTO users (id, username, password_hash, name, role, phone, email) VALUES
    ('admin001', 'admin', 'admin123', '系统管理员', 'admin', '13800138000', 'admin@oceanfarm.com'),
    ('farmer001', 'farmer', 'farmer123', '李养殖', 'farmer', '13800138001', 'farmer@oceanfarm.com'),
    ('tech001', 'technician', 'tech123', '王技术', 'technician', '13800138002', 'tech@oceanfarm.com'),
    ('finance001', 'finance', 'finance123', '张财务', 'finance', '13800138003', 'finance@oceanfarm.com')
  `);


type OrderStatus = 'pending' | 'shipped' | 'completed';
  db.run(`
    INSERT INTO zones (id, name, area, target_output, status, current_stock, growth_rate) VALUES
    ('zone001', 'A区 - 近海养殖区', 5000, 50000, 'normal', 35000, 0.85),
    ('zone002', 'B区 - 深海网箱区', 8000, 80000, 'normal', 62000, 0.92),
    ('zone003', 'C区 - 贝藻混养区', 3000, 25000, 'warning', 18000, 0.68),
    ('zone004', 'D区 - 珍品养殖区', 2000, 30000, 'normal', 22000, 0.95)
  `);

  db.run(`
    INSERT INTO disease_rules (id, zone_id, indicator, threshold, action) VALUES
    ('${uuidv4()}', 'zone001', 'growth_rate', 0.7, 'notify'),
    ('${uuidv4()}', 'zone001', 'dissolved_oxygen', 4.5, 'lock'),
    ('${uuidv4()}', 'zone002', 'growth_rate', 0.8, 'notify'),
    ('${uuidv4()}', 'zone003', 'growth_rate', 0.75, 'notify')
  `);

  db.run(`
    INSERT INTO threshold_configs (id, indicator, min, max, unit) VALUES
    ('${uuidv4()}', 'temperature', 18, 28, '°C'),
    ('${uuidv4()}', 'salinity', 20, 32, '‰'),
    ('${uuidv4()}', 'dissolved_oxygen', 5, 12, 'mg/L'),
    ('${uuidv4()}', 'ph', 7.0, 8.5, ''),
    ('${uuidv4()}', 'ammonia_nitrogen', 0, 0.5, 'mg/L'),
    ('${uuidv4()}', 'nitrite', 0, 0.2, 'mg/L')
  `);

  const speciesList = ['大黄鱼', '鲈鱼', '石斑鱼', '真鲷', '黑鲷'];
  for (let i = 0; i < 8; i++) {
    const zoneId = `zone00${(i % 4) + 1}`;
    const zoneNames: Record<string, string> = {
      'zone001': 'A区 - 近海养殖区',
      'zone002': 'B区 - 深海网箱区',
      'zone003': 'C区 - 贝藻混养区',
      'zone004': 'D区 - 珍品养殖区'
    };
    const species = speciesList[i % 5];
    const density = 6 + Math.random() * 4;
    const quantity = Math.floor(10000 + Math.random() * 20000);
    const temp = 20 + Math.random() * 6;
    const salinity = 24 + Math.random() * 6;
    const doValue = 6 + Math.random() * 4;
    const mortality = 0.03 + Math.random() * 0.05;
    const archiveId = uuidv4();
    
    const feedFormulas = [
      '高蛋白配方：鱼粉45% + 豆粕20% + 鱼油10% + 维生素5%',
      '均衡配方：鱼粉35% + 豆粕30% + 鱼油8% + 矿物质5%',
      '快速生长配方：鱼粉50% + 豆粕15% + 鱼油12% + 添加剂8%'
    ];
    
    const releaseDate = new Date(now);
    releaseDate.setDate(releaseDate.getDate() - i * 15 - 30);

    db.run(`
      INSERT INTO fry_releases 
      (id, zone_id, zone_name, species, quantity, recommended_density, feed_formula, 
       water_temp, salinity, dissolved_oxygen, historical_mortality, archive_id, operator, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `, [
      uuidv4(), zoneId, zoneNames[zoneId], species, quantity, density, 
      feedFormulas[i % 3], temp, salinity, doValue, mortality, 
      archiveId, '李养殖', releaseDate.toISOString()
    ]);

    db.run(`
      INSERT INTO breeding_archives (id, fry_release_id, content, created_at)
      VALUES (?, ?, ?, ?)
    `, [
      archiveId, uuidv4(),
      `养殖档案 - ${species}\n投放区域：${zoneNames[zoneId]}\n投放数量：${quantity}尾\n投放密度：${density.toFixed(1)}尾/㎡\n水质条件：水温${temp.toFixed(1)}°C，盐度${salinity.toFixed(1)}‰，溶氧${doValue.toFixed(1)}mg/L\n饲料配方：${feedFormulas[i % 3]}`,
      releaseDate.toISOString()
    ]);
  }

  for (let i = 0; i < 15; i++) {
    const zoneId = `zone00${(i % 4) + 1}`;
    const zoneNames: Record<string, string> = {
      'zone001': 'A区 - 近海养殖区',
      'zone002': 'B区 - 深海网箱区',
      'zone003': 'C区 - 贝藻混养区',
      'zone004': 'D区 - 珍品养殖区'
    };
    
    const temp = 18 + Math.random() * 12;
    const salinity = 18 + Math.random() * 16;
    const doValue = 4 + Math.random() * 10;
    const ph = 6.5 + Math.random() * 2.5;
    const ammonia = Math.random() * 0.8;
    const nitrite = Math.random() * 0.3;
    
    const abnormalItems: string[] = [];
    if (temp < 18 || temp > 28) abnormalItems.push('temperature');
    if (salinity < 20 || salinity > 32) abnormalItems.push('salinity');
    if (doValue < 5) abnormalItems.push('dissolved_oxygen');
    if (ph < 7 || ph > 8.5) abnormalItems.push('ph');
    if (ammonia > 0.5) abnormalItems.push('ammonia_nitrogen');
    if (nitrite > 0.2) abnormalItems.push('nitrite');
    
    const recordDate = new Date(now);
    recordDate.setDate(recordDate.getDate() - Math.floor(i / 4));

    db.run(`
      INSERT INTO water_quality 
      (id, zone_id, zone_name, temperature, salinity, dissolved_oxygen, ph, 
       ammonia_nitrogen, nitrite, recorded_by, recorded_at, is_normal, abnormal_items)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `, [
      uuidv4(), zoneId, zoneNames[zoneId], temp, salinity, doValue, ph,
      ammonia, nitrite, '王技术', recordDate.toISOString(),
      abnormalItems.length === 0 ? 1 : 0, JSON.stringify(abnormalItems)
    ]);
  }

  const warningData = [
    { zoneId: 'zone003', zoneName: 'C区 - 贝藻混养区', type: 'growth', level: 'medium', 
      indicator: 'growth_rate', currentValue: 0.68, threshold: 0.75, consecutiveDays: 3,
      suggestions: ['检查饲料配方是否合适', '增加投喂频率', '检测水质指标'] },
    { zoneId: 'zone001', zoneName: 'A区 - 近海养殖区', type: 'water_quality', level: 'high',
      indicator: 'dissolved_oxygen', currentValue: 4.2, threshold: 5.0, consecutiveDays: 2,
      suggestions: ['开启增氧设备', '减少投喂量', '监测水流情况'] },
    { zoneId: 'zone002', zoneName: 'B区 - 深海网箱区', type: 'water_quality', level: 'low',
      indicator: 'temperature', currentValue: 17.2, threshold: 18.0, consecutiveDays: 1,
      suggestions: ['关注天气变化', '适当调整投喂量'] }
  ];

  warningData.forEach((w, idx) => {
    const warnDate = new Date(now);
    warnDate.setDate(warnDate.getDate() - idx);
    db.run(`
      INSERT INTO warnings 
      (id, zone_id, zone_name, type, level, indicator, current_value, threshold, 
       consecutive_days, suggestions, status, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `, [
      uuidv4(), w.zoneId, w.zoneName, w.type, w.level, w.indicator, 
      w.currentValue, w.threshold, w.consecutiveDays, 
      JSON.stringify(w.suggestions), idx === 2 ? 'resolved' : 'pending',
      warnDate.toISOString()
    ]);
  });

  const plans = [
    { zoneId: 'zone001', species: '大黄鱼', stage: '成鱼期', amount: 150, freq: 3 },
    { zoneId: 'zone002', species: '鲈鱼', stage: '育成期', amount: 200, freq: 4 },
    { zoneId: 'zone004', species: '石斑鱼', stage: '育成期', amount: 80, freq: 2 }
  ];

  plans.forEach((p, idx) => {
    const zoneNames: Record<string, string> = {
      'zone001': 'A区 - 近海养殖区',
      'zone002': 'B区 - 深海网箱区',
      'zone003': 'C区 - 贝藻混养区',
      'zone004': 'D区 - 珍品养殖区'
    };
    const planId = uuidv4();
    db.run(`
      INSERT INTO feeding_plans 
      (id, zone_id, zone_name, species, growth_stage, daily_amount, frequency, 
       auto_adjust, weather_adjust, is_active, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `, [
      planId, p.zoneId, zoneNames[p.zoneId], p.species, p.stage, 
      p.amount, p.freq, 1, 1, 1, now.toISOString()
    ]);

    const weathers = ['晴天', '多云', '阴天', '小雨'];
    for (let i = 0; i < 10; i++) {
      const logDate = new Date(now);
      logDate.setDate(logDate.getDate() - i);
      const scheduled = p.amount;
      const actual = scheduled * (0.9 + Math.random() * 0.2);
      const reasons = ['', '天气原因调整', '生长阶段调整', '水质原因调整'];
      db.run(`
        INSERT INTO feeding_logs 
        (id, plan_id, zone_id, zone_name, scheduled_amount, actual_amount, 
         adjusted_reason, weather, growth_days, fed_at)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      `, [
        uuidv4(), planId, p.zoneId, zoneNames[p.zoneId], scheduled, actual,
        reasons[i % 4], weathers[i % 4], 120 + idx * 30 - i, logDate.toISOString()
      ]);
    }
  });

  for (let i = 0; i < 3; i++) {
    const zoneId = `zone00${i + 1}`;
    const zoneNames: Record<string, string> = {
      'zone001': 'A区 - 近海养殖区',
      'zone002': 'B区 - 深海网箱区',
      'zone003': 'C区 - 贝藻混养区',
      'zone004': 'D区 - 珍品养殖区'
    };
    const testDate = new Date(now);
    testDate.setDate(testDate.getDate() - i * 7);
    
    db.run(`
      INSERT INTO sample_tests 
      (id, zone_id, zone_name, average_weight, survival_rate, sample_count, tested_by, tested_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    `, [
      uuidv4(), zoneId, zoneNames[zoneId], 
      350 + Math.random() * 200, 0.8 + Math.random() * 0.15, 50 + i * 10,
      '王技术', testDate.toISOString()
    ]);
  }

  const taskStatuses: ('pending' | 'in_progress' | 'completed')[] = ['completed', 'pending', 'in_progress', 'pending'];
  for (let i = 0; i < 4; i++) {
    const zoneId = `zone00${i + 1}`;
    const zoneNames: Record<string, string> = {
      'zone001': 'A区 - 近海养殖区',
      'zone002': 'B区 - 深海网箱区',
      'zone003': 'C区 - 贝藻混养区',
      'zone004': 'D区 - 珍品养殖区'
    };
    const harvestDate = new Date(now);
    harvestDate.setDate(harvestDate.getDate() + i * 10 - 5);
    
    db.run(`
      INSERT INTO harvest_tasks 
      (id, zone_id, zone_name, predicted_output, harvest_date, status, task_order_no, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    `, [
      uuidv4(), zoneId, zoneNames[zoneId],
      30000 + Math.random() * 50000,
      harvestDate.toISOString().split('T')[0],
      taskStatuses[i],
      `HT${dateStr.replace(/-/g, '')}${String(i + 1).padStart(3, '0')}`,
      now.toISOString()
    ]);
  }

  const customers = ['海鲜批发有限公司', '美味餐饮集团', '鲜鱼直供电商', '星级酒店采购部', '水产交易市场'];
  for (let i = 0; i < 6; i++) {
    const zoneId = `zone00${(i % 4) + 1}`;
    const zoneNames: Record<string, string> = {
      'zone001': 'A区 - 近海养殖区',
      'zone002': 'B区 - 深海网箱区',
      'zone003': 'C区 - 贝藻混养区',
      'zone004': 'D区 - 珍品养殖区'
    };
    const species = speciesList[i % 5];
    const quantity = 500 + Math.random() * 2000;
    const price = 40 + Math.random() * 60;
    const traceCode = `TRACE${Date.now()}${i}`;
    const orderStatuses: OrderStatus[] = ['completed', 'shipped', 'pending', 'completed', 'shipped', 'pending'];
    const orderDate = new Date(now);
    orderDate.setDate(orderDate.getDate() - i * 3);

    db.run(`
      INSERT INTO orders 
      (id, order_no, zone_id, zone_name, species, quantity, unit_price, total_amount, 
       customer_name, trace_code, status, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `, [
      uuidv4(), `ORD${dateStr.replace(/-/g, '')}${String(i + 1).padStart(4, '0')}`,
      zoneId, zoneNames[zoneId], species, quantity, price, quantity * price,
      customers[i % 5], traceCode, orderStatuses[i], orderDate.toISOString()
    ]);

    db.run(`
      INSERT INTO trace_codes (code, order_id, archive_id, created_at)
      VALUES (?, ?, ?, ?)
    `, [traceCode, uuidv4(), uuidv4(), orderDate.toISOString()]);
  }


  const months = ['2026-04', '2026-05'];
  months.forEach((month, monthIdx) => {
    for (let i = 0; i < 4; i++) {
      const zoneId = `zone00${i + 1}`;
      const zoneNames: Record<string, string> = {
        'zone001': 'A区 - 近海养殖区',
        'zone002': 'B区 - 深海网箱区',
        'zone003': 'C区 - 贝藻混养区',
        'zone004': 'D区 - 珍品养殖区'
      };
      const baseOutput = 25000 + i * 15000;
      const output = baseOutput * (0.9 + monthIdx * 0.15);
      const fryCost = output * 8;
      const feedCost = output * 12;
      const laborCost = output * 6;
      const otherCost = output * 3;
      const income = output * (35 + Math.random() * 10);
      const totalCost = fryCost + feedCost + laborCost + otherCost;
      const profit = income - totalCost;

      db.run(`
        INSERT INTO finance_reports 
        (id, report_month, zone_id, zone_name, output, fry_cost, feed_cost, 
         labor_cost, other_cost, income, disease_loss_rate, profit, 
         output_change, cost_change, income_change, profit_change, pushed)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      `, [
        uuidv4(), month, zoneId, zoneNames[zoneId], output,
        fryCost, feedCost, laborCost, otherCost, income,
        0.02 + Math.random() * 0.04, profit,
        monthIdx === 0 ? null : 10 + Math.random() * 15,
        monthIdx === 0 ? null : 5 + Math.random() * 8,
        monthIdx === 0 ? null : 8 + Math.random() * 12,
        monthIdx === 0 ? null : 12 + Math.random() * 18,
        1
      ]);
    }
  });

  const messages = [
    { userId: 'farmer001', type: 'fry_release', title: '鱼苗投放成功', 
      content: '您在A区的大黄鱼鱼苗投放已完成，养殖档案已生成。', hasVoucher: true },
    { userId: 'farmer001', type: 'warning', title: '水质预警提醒', 
      content: 'A区溶解氧含量连续2天低于阈值，请及时处理。', hasVoucher: false },
    { userId: 'tech001', type: 'warning', title: '新的预警工单', 
      content: 'C区生长速率连续3天低于阈值，请安排现场检测。', hasVoucher: false },
    { userId: 'admin001', type: 'system', title: '月度报表已推送', 
      content: '2026年5月财务报表已生成并推送到您的手机端。', hasVoucher: true },
    { userId: 'farmer001', type: 'harvest', title: '捕捞任务已创建', 
      content: 'B区鲈鱼捕捞任务单已生成，请按时安排捕捞作业。', hasVoucher: true },
    { userId: 'farmer001', type: 'sale', title: '订单已完成', 
      content: '订单ORD202606100001已完成，溯源码已生成。', hasVoucher: true }
  ];

  messages.forEach((msg, idx) => {
    const msgDate = new Date(now);
    msgDate.setHours(msgDate.getHours() - idx * 4);
    db.run(`
      INSERT INTO messages 
      (id, user_id, type, title, content, related_id, related_type, 
       has_voucher, voucher_url, is_read, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `, [
      uuidv4(), msg.userId, msg.type, msg.title, msg.content,
      uuidv4(), msg.type, msg.hasVoucher ? 1 : 0,
      msg.hasVoucher ? `/vouchers/${uuidv4()}.pdf` : null,
      idx >= 4 ? 1 : 0, msgDate.toISOString()
    ]);
  });
};

export const getDb = async (): Promise<Database> => {
  if (!db) {
    await initDatabase();
  }
  return db!;
};

export default initDatabase;
